DATABASE_URL=postgresql+asyncpg://voltpos:your_password@localhost/voltpos_db
SECRET_KEY=replace-with-random-32-char-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Web Push (VAPID). Сгенерировать ключи:  npx web-push generate-vapid-keys
# Скопировать public/private (base64url) сюда. SUBJECT — mailto или https URL для контакта Push-сервиса.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@voltpos.online
